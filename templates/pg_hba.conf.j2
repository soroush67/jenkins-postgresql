# Rendered by roles/postgres - generated by Ansible, do not edit by hand.
#
# The original file had `local all all trust` - unauthenticated,
# passwordless, superuser-equivalent access to anyone who could get a
# shell in the container (e.g. `docker exec`). Replaced with `peer
# map=pgmap` (see pg_ident.conf) instead of `scram-sha-256`: peer auth
# still requires no password, but ONLY for a connecting process that is
# actually running as this exact container's own "postgres" OS user
# (uid 70) - i.e. `docker exec --user postgres` access to this specific
# container, not "any local host user" the way `trust` was. This is what
# lets roles/postgres reset a role's password without already knowing
# the current one (needed for real: a redeploy with a changed
# pg_password/pg_exporter_password against an EXISTING data directory
# would otherwise be permanently locked out, confirmed directly).
local   all             all                                     peer map=pgmap
host    all             all             127.0.0.1/32            scram-sha-256
host    all             all             {{ pg_hba_allowed_cidr }}            scram-sha-256
