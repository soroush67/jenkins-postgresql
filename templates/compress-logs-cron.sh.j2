#!/usr/bin/env bash
# Rendered by roles/postgres - generated by Ansible, do not edit by hand.
#
# Runs as this deploying user (via cron, no become/sudo - see
# roles/postgres's own comments on this task) - NOT inside a container.
# Does the actual compression via a throwaway container running as the
# postgres image's own uid (which alone has access to pg_logs_root's
# contents) - see compress-pg-logs.sh for why no signal to the live
# server is needed here, unlike mongo-stack.
set -uo pipefail

LOG_FILE="{{ pg_deploy_path }}/compress-logs.log"
{
    echo "=== $(date -Is) ==="

    if docker run --rm \
        --user {{ pg_run_uid }}:{{ pg_run_gid }} \
        -v "{{ pg_deploy_path }}/compress-pg-logs.sh:/compress.sh:ro" \
        -v "{{ pg_logs_root }}:/logs" \
        --entrypoint bash \
        "{{ pg_postgres_image }}" /compress.sh; then
        echo "compression: ok"
    else
        echo "compression: FAILED (exit $?)"
    fi
} >> "$LOG_FILE" 2>&1

# Keep the compression log itself from growing forever.
tail -n 1000 "$LOG_FILE" > "${LOG_FILE}.tmp" && mv "${LOG_FILE}.tmp" "$LOG_FILE"
