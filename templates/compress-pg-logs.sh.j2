#!/usr/bin/env bash
# Rendered by roles/postgres - generated by Ansible, do not edit by hand.
#
# Runs INSIDE a throwaway container as the postgres image's own uid
# ({{ pg_run_uid }}:{{ pg_run_gid }}) - confirmed directly that
# pg_logs_root's contents are owned by that uid, mode 0700 (handed over
# once and never touched again by this deploying user, same pattern as
# pg_data_root), so this deploying user genuinely cannot gzip/delete
# these files directly. Invoked by compress-logs-cron.sh, not run
# standalone.
#
# Unlike mongo-stack's log rotation, no signal to the live server is
# needed here at all: postgresql.conf already has PostgreSQL's own
# built-in log_rotation_age/log_rotation_size doing the actual
# rotation, into a freshly, uniquely timestamped file
# (log_filename = 'postgresql-%Y-%m-%d_%H%M%S.log') every time - it
# never reopens or continues writing to an older file once rotated away
# from it. This script's only job is compressing the ones postgres has
# already finished with and rotated away from, and deleting the oldest
# beyond the configured retention count - the gap postgres's own
# rotation leaves open (it compresses nothing and deletes nothing on
# its own, so log files would otherwise accumulate as plain text
# forever).
set -euo pipefail
LOG_DIR="/logs"
KEEP="{{ pg_log_rotate_keep }}"

cd "$LOG_DIR"

# Sort by FILENAME, not mtime - confirmed directly that `ls -t` is
# unreliable here: two files compressed moments apart landed on an
# IDENTICAL mtime (this filesystem/gzip's timestamp resolution),
# making `ls -t`'s ordering among them unpredictable and causing
# retention to delete the wrong one in testing. postgres's own
# log_filename format already embeds a sortable timestamp
# (YYYY-MM-DD_HHMMSS), so plain filename sort has no such ambiguity -
# the lexicographically last *.log is always the most recently
# created, and therefore the one postgres currently has open.
active=$(ls -1 *.log 2>/dev/null | sort | tail -n 1 || true)

for f in *.log; do
    [ -e "$f" ] || continue
    if [ "$f" != "$active" ]; then
        gzip "$f"
    fi
done

ls -1 *.log.gz 2>/dev/null | sort -r | tail -n +$((KEEP + 1)) | xargs -r rm -f
