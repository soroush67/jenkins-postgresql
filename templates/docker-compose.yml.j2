# Rendered by roles/postgres for {{ inventory_hostname }} - generated by
# Ansible, do not edit by hand.
networks:
  back-net:
    driver: bridge
    external: true
  db-net:
    driver: bridge
    external: true

services:
  postgres:
    image: "{{ pg_postgres_image }}"
    container_name: "{{ pg_container_name }}"
    restart: always

    # Not root - the image's own built-in "postgres" user (uid/gid 70),
    # confirmed directly. Lets cap_drop: ALL below actually hold: with
    # the default root startup, the entrypoint's own gosu/chown dance
    # needs CAP_CHOWN/CAP_SETUID/CAP_SETGID; running as this fixed
    # non-root uid from the start needs none of that, as long as
    # pg_data_root is already owned by it (see roles/postgres).
    user: "{{ pg_run_uid }}:{{ pg_run_gid }}"

    environment:
      POSTGRES_DB: "{{ pg_db }}"
      POSTGRES_USER: "{{ pg_user }}"
      POSTGRES_PASSWORD: "{{ pg_password }}"
      TZ: "{{ pg_timezone }}"

    ports:
      - "{{ pg_port }}:5432"

    volumes:
      # /var/lib/postgresql, not /var/lib/postgresql/data - PostgreSQL
      # 18's official image moved to major-version-specific subdirectories
      # under a single mount point (pg_ctlcluster-style layout); the old
      # .../data mount point is explicitly rejected with a startup error
      # in 18+, confirmed directly.
      - "{{ pg_data_root }}:/var/lib/postgresql"
      - "{{ pg_config_root }}/postgresql.conf:/etc/postgresql/postgresql.conf:ro"
      - "{{ pg_config_root }}/pg_hba.conf:/etc/postgresql/pg_hba.conf:ro"
      - "{{ pg_config_root }}/pg_ident.conf:/etc/postgresql/pg_ident.conf:ro"
      - "{{ pg_logs_root }}:/var/log/postgresql"
      - "{{ pg_init_root }}:/docker-entrypoint-initdb.d:ro"

    command: >
      postgres
      -c config_file=/etc/postgresql/postgresql.conf
      -c hba_file=/etc/postgresql/pg_hba.conf
      -c ident_file=/etc/postgresql/pg_ident.conf

    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ pg_user }} -d {{ pg_db }} -h 127.0.0.1 -p 5432"]
      interval: 10s
      timeout: 5s
      retries: 5

    cap_drop:
      - ALL
    security_opt:
      - "no-new-privileges:true"

    networks:
      - db-net
      - back-net
    mem_limit: "{{ pg_mem_limit }}"
    mem_reservation: "{{ pg_mem_reservation }}"
    cpus: {{ pg_cpus }}

  postgres_exporter:
    image: "{{ pg_exporter_image }}"
    container_name: "{{ pg_exporter_container_name }}"
    restart: always

    user: "{{ pg_exporter_run_uid }}:{{ pg_exporter_run_gid }}"

    environment:
      # pg_exporter_user, not a hardcoded/mismatched name - the original
      # file created a DB role named "pg_exporter" but connected here as
      # "postgres_exporter"; both now come from the same variable so they
      # can't drift again (see roles/postgres for the password-sync step
      # that keeps the DB role in sync on redeploys too, since
      # docker-entrypoint-initdb.d scripts only run once, on a genuinely
      # empty data directory).
      DATA_SOURCE_NAME: "postgresql://{{ pg_exporter_user }}:{{ pg_exporter_password }}@postgres:5432/postgres?sslmode=disable"

    volumes:
      - "{{ pg_config_root }}/postgres-exporter/postgres_exporter.yml:/etc/postgres_exporter/postgres_exporter.yml:ro"

    command:
      - "--config.file=/etc/postgres_exporter/postgres_exporter.yml"
    ports:
      - "{{ pg_exporter_port }}:9187"

    cap_drop:
      - ALL
    security_opt:
      - "no-new-privileges:true"

    # Explicit, unlike the original file - a service with no `networks:`
    # key joins Compose's own implicit "default" project network, NOT
    # whatever custom networks other services declare. The original file
    # left this exporter off db-net/back-net entirely, meaning it could
    # never actually reach "postgres:5432" - confirmed by reading the
    # compose spec's default-network behavior, not assumed.
    networks:
      - db-net
      - back-net

    depends_on:
      postgres:
        condition: service_healthy
