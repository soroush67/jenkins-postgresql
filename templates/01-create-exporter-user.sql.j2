-- Rendered by roles/postgres - generated by Ansible, do not edit by hand.
-- Only runs on a genuinely empty data directory (docker-entrypoint-initdb.d
-- convention) - redeploys with a changed pg_exporter_password rely on
-- roles/postgres's separate ALTER USER step to stay in sync, not this file.
CREATE USER {{ pg_exporter_user }} WITH PASSWORD '{{ pg_exporter_password }}';
GRANT CONNECT ON DATABASE postgres TO {{ pg_exporter_user }};
GRANT pg_monitor TO {{ pg_exporter_user }};
