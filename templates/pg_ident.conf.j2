# Rendered by roles/postgres - generated by Ansible, do not edit by hand.
#
# Maps the container's own OS user "postgres" (uid 70 - the only
# identity `docker exec --user postgres` can ever present on the local
# unix socket) to the appuser role, for peer auth on local connections
# only (see pg_hba.conf's `local` rule) - lets roles/postgres reset
# appuser's/the exporter's password without already knowing the current
# one, without reintroducing `trust` (peer still requires the connecting
# process to actually BE that specific container-local OS identity,
# which requires `docker exec` access to this exact container - not
# "any local host user" the way `trust` was).
# MAPNAME       SYSTEM-USERNAME         PG-USERNAME
pgmap           postgres                {{ pg_user }}
